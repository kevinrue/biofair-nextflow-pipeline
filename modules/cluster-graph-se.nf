process CLUSTER_GRAPH_SE {
    tag "${meta.id}"
    container 'ghcr.io/kevinrue/scrapper:devel'
    cpus 1
    memory '4 GB'
    disk '10 GB'

    input:
    // meta: map identifying the unit of work; meta.id names the tag
    // infile: Input SingleCellExperiment (h5ad)
    tuple val(meta), path(infile, name: 'infile.h5ad')
    // Number of neighbours (integer; default in spec: 10)
    val neighbours
    // Community detection method (one of: multilevel, leiden, walktrap; default in spec: multilevel)
    val method
    // Clustering resolution (float; default in spec: 1)
    val resolution

    output:
    tuple val(meta), path('outfile.h5ad'), emit: outfile

    script:
    """
    Rscript -e 'BiocJobs::execJob("scrapper", "cluster-graph-se")' \\
        --infile '${(infile as String).replace("'", "'\\''")}' \\
        --neighbours '${(neighbours as String).replace("'", "'\\''")}' \\
        --method '${(method as String).replace("'", "'\\''")}' \\
        --resolution '${(resolution as String).replace("'", "'\\''")}' \\
        --outfile 'outfile.h5ad'
    """

    stub:
    """
    touch 'outfile.h5ad'
    """
}
