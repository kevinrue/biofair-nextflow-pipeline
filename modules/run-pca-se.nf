process RUN_PCA_SE {
    tag "${meta.id}"
    container 'ghcr.io/kevinrue/scrapper:devel'
    cpus 1
    memory '4 GB'
    disk '10 GB'

    input:
    // meta: map identifying the unit of work; meta.id names the tag
    // infile: Short UI label (h5ad)
    // features: Short UI label (txt)
    tuple val(meta), path(infile, name: 'infile.h5ad'), path(features, name: 'features.txt')
    // Number of PCs to retain (float; default in spec: 25)
    val n_pcs

    output:
    tuple val(meta), path('outfile.h5ad'), emit: outfile

    script:
    """
    Rscript -e 'BiocJobs::execJob("scrapper", "run-pca-se")' \\
        --infile '${(infile as String).replace("'", "'\\''")}' \\
        --features '${(features as String).replace("'", "'\\''")}' \\
        --n_pcs '${(n_pcs as String).replace("'", "'\\''")}' \\
        --outfile 'outfile.h5ad'
    """

    stub:
    """
    touch 'outfile.h5ad'
    """
}
